{
  "name": "atpr-to-addon",
  "version": "1.3.0",
  "private": true,
  "description": "A browser extension for the atpr.to link shortener",
  "scripts": {
    "clean": "rimraf dist",
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "dev:firefox": "web-ext run --source-dir=src",
    "lint:firefox": "web-ext lint --source-dir=dist/firefox",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "web-ext": "^10.7.0"
  }
}